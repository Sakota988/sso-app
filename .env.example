# Copy to .env and adjust for your setup.

# SSO Nest API (sso-backend). No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Platform defaults if unset:
#   iOS Simulator:     http://localhost:3001
#   Android Emulator:  http://10.0.2.2:3001
#   Physical device:   http://<your-computer-LAN-IP>:3001  (same Wi‑Fi as phone)

# Optional: ngrok token for Expo tunnel mode
# NGROK_AUTHTOKEN=
